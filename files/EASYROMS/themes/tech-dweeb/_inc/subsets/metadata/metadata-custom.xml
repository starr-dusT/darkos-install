<view name="detailed">

<image name="md-media-mask">
<path>./_inc/systems/default/centered/${airencolor}.png</path>
<zIndex>6</zIndex>
</image>

<image name="md_image">
<origin>0.5 0.5</origin>
<pos>0.729166666666667 0.40625</pos><!-- 350,130 -->
<size>0.8 0</size>
<zIndex>5</zIndex>
</image>

<image name="md_marquee">
<visible>true</visible>
<origin>0 1</origin>
<pos>0.479166666666667 0.84375</pos>
<maxSize>0.270833333333333 0.3125</maxSize>
</image>

</view>



<view name="grid">

<image name="logo">
<visible>true</visible>
<origin>0.5 0</origin>
<pos>0.5 0.015</pos>
</image>

<image name="md-media-mask">
<path>./_inc/systems/default/centered/fullscreen-default-grid.png</path>
</image>

</view>


	<!-- This is most important mask section -->
	<view name="video">
<image name="logo">
<visible>true</visible>
<origin>0.5 0</origin>
<pos>0.2 0.085</pos>
<maxSize>0.5 0.12</maxSize>
</image>
		<textlist name="gamelist">
			<pos>0.0 0.22</pos>
			<size>0.365 0.8</size>
			<alignment>left</alignment>
			<primaryColor>${customcolorheader}</primaryColor>
<lineSpacing>1.9</lineSpacing>
		</textlist>

		<text name="md_lbl_genre">
			<pos>0.5 0.875</pos>
		</text>
		<text name="md_genre">
			<pos>0.5 0.91875</pos>
			<color>C0C0C0</color>
		</text>

		<text name="md_lbl_publisher">
			<visible>false</visible>
		</text>
		<text name="md_publisher">
			<visible>false</visible>
		</text>
		<image name="md_marquee">
			<visible>true</visible>
			<origin>0 1</origin>
			<pos>0.479166666666667 0.84375</pos>
			<maxSize>0.270833333333333 0.3125</maxSize>
		</image>

		<video name="md_video">
			<origin>0.5 0.5</origin>
			<pos>0.729166666666667 0.375</pos>
			<maxSize>1.1 1.6</maxSize>
			
			<!-- bypass of resizing video -->
			<storyboard>
				<animation property="h" from="1" begin="1" duration="0" mode="linear"/>
				<animation property="w" from="1" begin="1" duration="0" mode="linear"/>
				<animation property="x" from="1" begin="1" duration="0" mode="linear"/>
				<animation property="y" from="1" begin="1" duration="0" mode="linear"/>
				<animation property="opacity" from="0" to="1" duration="100" mode="linear"/>
				<animation property="scale" from="1" to="1" duration="0" mode="easeOut"/>
			</storyboard>
			<delay>0.01</delay>
			<showSnapshotNoVideo>true</showSnapshotNoVideo>
			<showSnapshotDelay>false</showSnapshotDelay>
			<snapshotSource>image</snapshotSource>
			<!-- bypass of resizing video -->
		</video>

<image name="md-media-mask">
<path>./_inc/systems/default/centered/fullscreen-default.png</path>
</image>

   </view>



</theme>