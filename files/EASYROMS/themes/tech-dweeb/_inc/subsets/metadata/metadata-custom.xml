<theme>
	<formatVersion>7</formatVersion>
	


	<view name="detailed, grid, video">
      <!-- Logo -->
		<text name="logoText">
			<fontPath>${logoFont}</fontPath>
			<forceUppercase>true</forceUppercase>
			<lineSpacing>1</lineSpacing>
			<size>0.38 0</size>
			<pos>0 0.1</pos>
			<alignment>center</alignment>
			<fontSize>0.07</fontSize>
			<color>ffffff</color>
		</text>


	</view>

	<view name="basic">
		<textlist name="gamelist">
      <text name="system-name" extra="true">
         <visible>false</visible>
      </text>

<image name="logo">
<visible>true</visible>
<origin>0.5 0</origin>
<pos>0.2 0.085</pos>
<maxSize>0.5 0.12</maxSize>
</image>

<pos>0.0 0.22</pos>
<size>1 0.78</size>
<fontSize>${gamelistFontSize}</fontSize>
<alignment>center</alignment>
<primaryColor>${customcolorheader}</primaryColor>
<selectorColor>ffffff</selectorColor>
<selectedColor>000000</selectedColor>
		</textlist>
	</view>
	
	<view name="detailed">
      <text name="system-name" extra="true">
         <visible>false</visible>
      </text>

<image name="logo">
<visible>true</visible>
<origin>0.5 0</origin>
<pos>0.2 0.085</pos>
<maxSize>0.5 0.12</maxSize>
</image>

<textlist name="gamelist">
<pos>0.0 0.22</pos>
<size>0.365 0.78</size>
<fontSize>${gamelistFontSize}</fontSize>
<lineSpacing>1.9</lineSpacing>
<alignment>left</alignment>
<primaryColor>${customcolorheader}</primaryColor>
<selectorColor>ffffff</selectorColor>
<selectedColor>000000</selectedColor>
</textlist>

</view>

	<view name="detailed">
