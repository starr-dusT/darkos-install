<theme>
   <formatVersion>7</formatVersion>

	<view name="system">
		<!-- <image name="background-art" extra="true"> -->
		<image name="staticBackground" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
<!-- <size>1 0</size> -->
			<path>./_inc/systems/default/fullscreen-green.png</path>
			<tile>false</tile>
			<color>ffffff</color>
			<zIndex>2</zIndex>
		</image>

		<image name="top-background" extra="true">
			<origin>0 0</origin>
			<pos>0 0</pos>
			<size>1 0.09375</size>
			<path>${spacerImage}</path>
			<tile>true</tile>
			<color>11111144</color>
			<zIndex>3</zIndex>
		</image>

		<text name="systemInfo">
			<fontPath>${bodyFont}</fontPath>
			<pos>0 0.013</pos>
			<fontSize>0.0375</fontSize>
			<color>FFFFFF55</color>
		</text>
	</view>

	<variables>
		<customcolorheader>c8ed00</customcolorheader>
		<customcolorsubheader>6d8100</customcolorsubheader>
		<customcolorfoooter>6d8100</customcolorfoooter>
	</variables>

</theme>
