<theme>
   <formatVersion>7</formatVersion>

	<view name="system">
		<!-- <image name="background-art" extra="true"> -->
		<image name="staticBackground" extra="true">
			<origin>0.5 0.5</origin>
			<pos>0.5 0.5</pos>
<!-- <size>1 0</size> -->
			<path>./_inc/systems/default/fullscreen-orange.png</path>
			<!-- <path>./_inc/systems/carbon/${system.theme}-carb.jpg</path> -->
			<tile>false</tile>
			<color>ffffff</color>
			<zIndex>2</zIndex>
		</image>

		<image name="top-background" extra="true">
			<origin>0 0</origin>
			<pos>0 0</pos>
			<size>1 0.09375</size>
			<path>${spacerImage}</path>
			<tile>true</tile>
			<color>11111144</color>
			<zIndex>3</zIndex>
		</image>

		<text name="systemInfo">
			<fontPath>${bodyFont}</fontPath>
			<pos>0 0.013</pos>
			<fontSize>0.0375</fontSize>
			<color>FFFFFF55</color>
		</text>
	</view>
	
	<view name="video">
		<textlist name="gamelist">
			<primaryColor>9e4700</primaryColor>
		</textlist>
	</view>


	<variables>
		<customcolorheader>ff7300</customcolorheader>
		<customcolorsubheader>c15700</customcolorsubheader>
		<customcolorfoooter>c15700</customcolorfoooter>
	</variables>

</theme>
